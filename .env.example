# ─────────────────────────────────────────────────────────────
# Environment variables — copy this file to `.env` for local dev
# and add the same names in Vercel → Settings → Environment Variables.
#
# VITE_*   exposed to the browser at BUILD time (never put secrets here)
# others   server-side only, available to api/*.js and shared/*.mjs
#
# After changing any variable in Vercel: redeploy (env is inlined
# into the bundle for VITE_*, and injected into functions at runtime).
# ─────────────────────────────────────────────────────────────

# ── Frontend (public values — safe in the browser) ─────────────
# Firebase console → Project settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Razorpay Dashboard → Settings → API Keys → Key Id (public)
VITE_RAZORPAY_KEY_ID=

# Public store origin + display name
VITE_APP_ORIGIN=http://localhost:3000
VITE_STORE_NAME=Laxmiclothhouse

# ── Razorpay (server-side, SECRET) ─────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Dashboard → Settings → Webhooks → the signing secret
RAZORPAY_WEBHOOK_SECRET=

# ── Firebase server-side (serverless functions) ────────────────
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=

# ── Transactional e-mail (Resend) ──────────────────────────────
RESEND_API_KEY=
MAIL_FROM=
MERCHANT_EMAIL=

# ── WhatsApp Cloud API (Meta) ──────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=order_update
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_SALE_TEMPLATE_NAME=sale_notify
WHATSAPP_SALE_TEMPLATE_LANG=en
WHATSAPP_GRAPH_VERSION=v23.0

# ── WhatsApp via Twilio (optional fallback) ────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── Delhivery (shipping + tracking) ────────────────────────────
DELHIVERY_API_TOKEN=
DELHIVERY_PICKUP_NAME=
DELHIVERY_WEBHOOK_SECRET=
# DELHIVERY_API_BASE=https://track.delhivery.com
# DELHIVERY_DEMO=0

# ── Misc ───────────────────────────────────────────────────────
# Public store origin used in e-mails/WhatsApp links.
APP_ORIGIN=
STORE_NAME=Laxmiclothhouse